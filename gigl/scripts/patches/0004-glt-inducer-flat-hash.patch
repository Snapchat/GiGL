+// Same output as InduceNext above, with one table operation per edge and one
+// per source. The neighbor insertion pass writes each edge's column directly,
+// and a source's local id is looked up once for all of its neighbors.
+HeteroCOO CPUHeteroInducer::InduceNextFlat(const HeteroNbr& nbrs) {
+  auto tensor_option = std::get<0>(nbrs.begin()->second).options();
+  std::unordered_map<std::string, std::vector<int64_t>> out_nodes;
+  // Iterating `nbrs` twice visits the edge types in the same order, so the
+  // column tensors created here are matched to their edge types below by position.
+  std::vector<torch::Tensor> cols_by_position;
+  cols_by_position.reserve(nbrs.size());
+  for (const auto& iter : nbrs) {
+    const auto& dst_type = std::get<2>(iter.first);
+    const auto& dst = std::get<1>(iter.second);
+    const auto dst_size = dst.size(0);
+    const auto dst_ptr = dst.data_ptr<int64_t>();
+    auto& dst_glob2local = flat_glob2local_[dst_type];
+    auto& dst_out_nodes = out_nodes[dst_type];
+    dst_out_nodes.reserve(dst_size);
+    int64_t n_id = nodes_size_[dst_type];
+    torch::Tensor cols = torch::empty(dst_size, tensor_option);
+    auto cols_ptr = cols.data_ptr<int64_t>();
+    for (int32_t i = 0; i < dst_size; ++i) {
+      bool inserted;
+      cols_ptr[i] = dst_glob2local.Insert(dst_ptr[i], n_id, inserted);
+      if (inserted) {
+        dst_out_nodes.push_back(dst_ptr[i]);
+        ++n_id;
+      }
+    }
+    nodes_size_[dst_type] = n_id;
+    cols_by_position.push_back(std::move(cols));
+  }
+
+  TensorEdgeMap rows_dict;
+  TensorEdgeMap cols_dict;
+  TensorMap nodes_dict;
+  for (auto& iter : out_nodes) {
+    torch::Tensor nodes = torch::empty(iter.second.size(), tensor_option);
+    std::copy(iter.second.begin(), iter.second.end(), nodes.data_ptr<int64_t>());
+    nodes_dict.emplace(iter.first, std::move(nodes));
+  }
+
+  size_t position = 0;
+  for (const auto& iter : nbrs) {
+    const auto src_ptr = std::get<0>(iter.second).data_ptr<int64_t>();
+    const auto nbrs_num_ptr = std::get<2>(iter.second).data_ptr<int64_t>();
+    const auto src_size = std::get<0>(iter.second).size(0);
+    const auto edge_size = std::get<1>(iter.second).size(0);
+    const auto& src_glob2local = flat_glob2local_[std::get<0>(iter.first)];
+
+    torch::Tensor rows = torch::empty(edge_size, tensor_option);
+    auto rows_ptr = rows.data_ptr<int64_t>();
+    int32_t cnt = 0;
+    for (int32_t i = 0; i < src_size; ++i) {
+      if (nbrs_num_ptr[i] == 0) {
+        continue;
+      }
+      const int32_t* row = src_glob2local.Find(src_ptr[i]);
+      if (row == nullptr) {
+        throw std::out_of_range("unordered_map::at");
+      }
+      for (int32_t j = 0; j < nbrs_num_ptr[i]; ++j) {
+        rows_ptr[cnt++] = *row;
+      }
+    }
+    rows_dict.emplace(iter.first, std::move(rows));
+    cols_dict.emplace(iter.first, std::move(cols_by_position[position++]));
+  }
+  return std::make_tuple(nodes_dict, rows_dict, cols_dict);
+}
+
 void CPUHeteroInducer::Reset() {
   for (auto& i : glob2local_) {
     i.second.clear();
   }
+  for (auto& i : flat_glob2local_) {
+    i.second.Clear();
+  }
   for (auto& i : nodes_size_) {
     i.second = 0;
   }
