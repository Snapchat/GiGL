+#include <vector>
+
+namespace graphlearn_torch {
+
+// Open-addressing hash table from int64 keys to int32 values: power-of-two
+// capacity, linear probing, a load factor of at most 1/2, and growth by
+// doubling. Memory is 16 bytes per slot and is bounded by the number of
+// distinct keys inserted, never by the key range. Values are never changed once
+// inserted and keys are never erased individually; Clear() empties the table
+// but keeps its capacity. INT64_MIN marks an empty slot, so that one key is
+// kept in a dedicated member instead.
+class FlatIntMap {
+public:
+  // Largest number of entries a Reserve() hint pre-allocates for. Larger
+  // tables are reached by growing.
+  static constexpr size_t kMaxReserve = size_t(1) << 18;
+
+  FlatIntMap() {}
+
+  void Reserve(size_t num_entries) {
+    size_t capacity = kMinCapacity;
+    while (capacity < std::min(num_entries, kMaxReserve) * 2) {
+      capacity <<= 1;
+    }
+    if (capacity > slots_.size()) {
+      Rehash(capacity);
+    }
+  }
+
+  void Clear() {
+    std::fill(slots_.begin(), slots_.end(), Slot{kEmpty, 0});
+    size_ = 0;
+    has_empty_key_ = false;
+  }
+
+  // Returns the value stored under `key`. If `key` is absent, stores `value`
+  // under it and returns `value`; `inserted` tells which happened.
+  int32_t Insert(int64_t key, int32_t value, bool& inserted) {
+    if (key == kEmpty) {
+      inserted = !has_empty_key_;
+      if (inserted) {
+        has_empty_key_ = true;
+        empty_key_value_ = value;
+        ++size_;
+      }
+      return empty_key_value_;
+    }
+    if ((size_ + 1) * 2 > slots_.size()) {
+      Rehash(std::max(kMinCapacity, slots_.size() * 2));
+    }
+    size_t i = Position(key);
+    while (slots_[i].key != kEmpty) {
+      if (slots_[i].key == key) {
+        inserted = false;
+        return slots_[i].value;
+      }
+      i = (i + 1) & mask_;
+    }
+    slots_[i] = Slot{key, value};
+    ++size_;
+    inserted = true;
+    return value;
+  }
+
+  // Returns the value stored under `key`, or nullptr if there is none.
+  const int32_t* Find(int64_t key) const {
+    if (key == kEmpty) {
+      return has_empty_key_ ? &empty_key_value_ : nullptr;
+    }
+    if (slots_.empty()) {
+      return nullptr;
+    }
+    size_t i = Position(key);
+    while (slots_[i].key != kEmpty) {
+      if (slots_[i].key == key) {
+        return &slots_[i].value;
+      }
+      i = (i + 1) & mask_;
+    }
+    return nullptr;
+  }
+
+  size_t size() const { return size_; }
+  size_t capacity() const { return slots_.size(); }
+
+private:
+  struct Slot {
+    int64_t key;
+    int32_t value;
+  };
+
+  static constexpr int64_t kEmpty = INT64_MIN;
+  static constexpr size_t kMinCapacity = 1024;
+
+  size_t Position(int64_t key) const {
+    // Fibonacci hashing: the top bits of the product are well mixed.
+    return static_cast<size_t>(
+        (static_cast<uint64_t>(key) * 0x9E3779B97F4A7C15ULL) >> shift_);
+  }
+
+  void Rehash(size_t capacity) {
+    std::vector<Slot> old(capacity, Slot{kEmpty, 0});
+    old.swap(slots_);
+    mask_ = capacity - 1;
+    shift_ = 64 - __builtin_ctzll(capacity);
+    for (const Slot& slot : old) {
+      if (slot.key == kEmpty) {
+        continue;
+      }
+      size_t i = Position(slot.key);
+      while (slots_[i].key != kEmpty) {
+        i = (i + 1) & mask_;
+      }
+      slots_[i] = slot;
+    }
+  }
+
+  std::vector<Slot> slots_;
+  size_t mask_ = 0;
+  int shift_ = 0;
+  size_t size_ = 0;
+  bool has_empty_key_ = false;
+  int32_t empty_key_value_ = 0;
+};
+
+}  // namespace graphlearn_torch
+
+#endif // GRAPHLEARN_TORCH_CPU_FLAT_INT_MAP_H_
