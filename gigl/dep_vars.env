# WARNING ====================================================================================================

# The Python versions GiGL supports: the base images are built on these exact patches, the CI and release
# matrices use their minors. Comma-separated because bash sources this file. The default is the one in
# `.python-version`, which must be one of these exact versions.
SUPPORTED_PYTHON_VERSIONS=3.11.14,3.12.14,3.13.15
